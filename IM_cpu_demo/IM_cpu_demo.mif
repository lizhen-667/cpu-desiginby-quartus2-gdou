-- Quartus II generated Memory Initialization File (.mif)

WIDTH=16;
DEPTH=256;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
	000  :   0100;
	001  :   180F;
	002  :   2C12;
	003  :   3F12;
	004  :   4600;
	005  :   5600;
	006  :   6600;
	007  :   7000;
	008  :   8000;
	009  :   9400;
	00A  :   A800;
	00B  :   B600;
	00C  :   C600;
	00D  :   D010;
	00E  :   E020;
	00F  :   F000;
	010  :   7000;
	[011..0FF]  :   0000;
END;
